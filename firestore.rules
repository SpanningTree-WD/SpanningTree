rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function contentCollection(name) {
      return name in ['activities', 'mathematics', 'publications'];
    }
    function text(value, maximum) { return value is string && value.size() <= maximum; }
    function media(value) {
      return value is map && value.keys().hasAll(['alt', 'variant'])
        && value.keys().hasOnly(['alt', 'variant', 'caption', 'url'])
        && text(value.alt, 1000) && text(value.variant, 100)
        && (!('caption' in value) || text(value.caption, 5000))
        && (!('url' in value) || value.url.matches('/uploads/[a-f0-9]{64}[.](jpg|png|webp)'));
    }
    function attachment(value) {
      return value is map && value.keys().hasAll(['label', 'fileName', 'mediaType', 'sizeLabel'])
        && value.keys().hasOnly(['label', 'fileName', 'mediaType', 'sizeLabel', 'url'])
        && text(value.label, 1000) && text(value.fileName, 1000)
        && value.mediaType == 'application/pdf' && text(value.sizeLabel, 1000)
        && (!('url' in value) || value.url.matches('/uploads/[a-f0-9]{64}[.]pdf'));
    }

    function authoring(data) {
      return (!('assets' in data) || (data.assets is list && data.assets.size() <= 100))
        && (!('diagrams' in data) || (data.diagrams is list && data.diagrams.size() <= 100))
        && (!('authorIds' in data) || (data.authorIds is list && data.authorIds.size() <= 100 && data.authorIds.toSet().size() == data.authorIds.size()))
        && (!('participantIds' in data) || (data.participantIds is list && data.participantIds.size() <= 100 && data.participantIds.toSet().size() == data.participantIds.size()))
        && (!('participants' in data) || (data.participants is list && data.participants.size() <= 100))
        && (!('references' in data) || (data.references is list && data.references.size() <= 100))
        && (!('relationshipVersion' in data) || data.relationshipVersion == 2);
    }
    function uploadSession(uid, name, id) {
      let session = get(/databases/$(database)/documents/uploadSessions/$(uid)/records/$(id)).data;
      return session.collection == name && session.recordId == id && session.expiresAt > request.time;
    }
    match /uploadSessions/{uid}/records/{id} {
      allow get, delete: if uploadOwner(uid);
      allow list: if false;
      allow create, update: if uploadOwner(uid)
        && request.resource.data.keys().hasOnly(['collection', 'recordId', 'expiresAt', 'updatedAt'])
        && contentCollection(request.resource.data.collection)
        && request.resource.data.recordId == id && id.matches('[a-zA-Z0-9_-]{1,128}')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(2, 'd');
    }
    function newDiagram(data, uid) {
      return data.keys().hasOnly(['collection', 'recordId', 'requestId', 'ownerId', 'language', 'source', 'sourceHash', 'engine', 'state', 'createdAt', 'updatedAt'])
        && contentCollection(data.collection) && data.recordId.matches('[a-zA-Z0-9_-]{1,128}')
        && data.requestId.matches('[a-f0-9-]{36}') && data.ownerId == uid
        && data.language in ['tikz', 'asymptote'] && text(data.source, 20000) && data.source.size() > 0
        && data.sourceHash.matches('[a-f0-9]{64}') && data.engine == 'sandbox-v1'
        && data.state == 'queued' && data.createdAt == request.time && data.updatedAt == request.time
        && (exists(/databases/$(database)/documents/$(data.collection)/$(data.recordId)) || uploadSession(uid, data.collection, data.recordId));
    }
    match /diagramRequests/{uid} {
      allow get: if uploadOwner(uid);
      allow list, delete: if false;
      allow create: if uploadOwner(uid) && newDiagram(request.resource.data, uid);
      allow update: if uploadOwner(uid) && resource.data.state in ['complete', 'failed']
        && newDiagram(request.resource.data, uid) && request.resource.data.requestId != resource.data.requestId;
    }

    function common(data, id) {
      return data.keys().hasAll(['id', 'slug', 'title', 'summary', 'type', 'coverImage', 'status', 'createdAt', 'updatedAt'])
        && data.id == id && text(data.title, 500) && data.title.matches('.*[^\\s].*')
        && text(data.slug, 160) && data.slug.matches('[a-z0-9]+(-[a-z0-9]+)*')
        && text(data.summary, 20000) && text(data.type, 100) && data.type.size() > 0
        && authoring(data) && media(data.coverImage) && data.status in ['draft', 'published']
        && data.updatedAt == request.time;
    }
    function activity(data) {
      return data.keys().hasAll(['description', 'date', 'gallery', 'tags', 'relatedMathematics', 'relatedPublications', 'featured'])
        && data.keys().hasOnly(['id', 'slug', 'title', 'summary', 'type', 'coverImage', 'status', 'createdAt', 'updatedAt', 'description', 'date', 'gallery', 'tags', 'relatedMathematics', 'relatedPublications', 'featured', 'attachments', 'assets', 'diagrams', 'participantIds', 'participants', 'authorIds'])
        && text(data.description, 800000) && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.gallery is list && data.gallery.size() <= 100 && data.tags is list
        && data.relatedMathematics is list && data.relatedPublications is list && data.featured is bool
        && (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 100));
    }
    // Optional for legacy records; new editors also retain the first field.
    function mathematicsField(value) {
      return value is string && value.size() <= 100 && value.matches('.*[^\\\\s].*');
    }
    function validMathematicsFields(value, primary) {
      let count = value.size();
      return value is list && count >= 1 && count <= 16
        && value.toSet().size() == count && value[0] == primary
        && (count <= 0 || mathematicsField(value[0]))
        && (count <= 1 || mathematicsField(value[1]))
        && (count <= 2 || mathematicsField(value[2]))
        && (count <= 3 || mathematicsField(value[3]))
        && (count <= 4 || mathematicsField(value[4]))
        && (count <= 5 || mathematicsField(value[5]))
        && (count <= 6 || mathematicsField(value[6]))
        && (count <= 7 || mathematicsField(value[7]))
        && (count <= 8 || mathematicsField(value[8]))
        && (count <= 9 || mathematicsField(value[9]))
        && (count <= 10 || mathematicsField(value[10]))
        && (count <= 11 || mathematicsField(value[11]))
        && (count <= 12 || mathematicsField(value[12]))
        && (count <= 13 || mathematicsField(value[13]))
        && (count <= 14 || mathematicsField(value[14]))
        && (count <= 15 || mathematicsField(value[15]));
    }
    function mathematics(data) {
      return data.keys().hasAll(['content', 'authors', 'field', 'year', 'tags', 'attachments', 'relatedActivities', 'relatedPublications', 'relatedMathematics'])
        && data.keys().hasOnly(['id', 'slug', 'title', 'summary', 'type', 'coverImage', 'status', 'createdAt', 'updatedAt', 'content', 'authors', 'field', 'year', 'tags', 'attachments', 'relatedActivities', 'relatedPublications', 'relatedMathematics', 'publishedAt', 'fields', 'assets', 'diagrams', 'authorIds', 'references', 'relationshipVersion'])
        && text(data.content, 800000) && data.authors is list && text(data.field, 100) && data.field.size() > 0
        && (!('fields' in data) || validMathematicsFields(data.fields, data.field))
        && data.year is int && data.year >= 1900 && data.year <= 9999
        && data.tags is list && data.attachments is list && data.attachments.size() <= 100
        && data.relatedActivities is list && data.relatedPublications is list && data.relatedMathematics is list
        && (!('publishedAt' in data) || data.publishedAt is timestamp || data.publishedAt is string);
    }
    function publication(data) {
      return data.keys().hasAll(['description', 'year', 'authors', 'editors', 'relatedActivities', 'relatedMathematics'])
        && data.keys().hasOnly(['id', 'slug', 'title', 'summary', 'type', 'coverImage', 'status', 'createdAt', 'updatedAt', 'description', 'year', 'authors', 'editors', 'relatedActivities', 'relatedMathematics', 'pdf', 'assets', 'diagrams', 'authorIds'])
        && text(data.description, 800000) && data.year is int && data.year >= 1900 && data.year <= 9999
        && data.authors is list && data.editors is list && data.relatedActivities is list && data.relatedMathematics is list
        && (!('pdf' in data) || attachment(data.pdf));
    }
    function validClaim(name, id, data) {
      let claim = getAfter(/databases/$(database)/documents/contentSlugs/$(name + ':' + data.slug)).data;
      return claim.recordId == id && claim.collection == name && claim.slug == data.slug;
    }
    function validContent(name, id) {
      let data = request.resource.data;
      return common(data, id) && ((resource != null && data.slug == resource.data.slug) || validClaim(name, id, data))
        && ((name == 'activities' && activity(data)) || (name == 'mathematics' && mathematics(data)) || (name == 'publications' && publication(data)));
    }

    // One private, bounded upload slot per administrator. Only the worker can finish it.
    function uploadOwner(uid) { return isAdmin() && request.auth.uid == uid; }
    function newUpload(data, uid) {
      return data.keys().hasAll(['uploadId', 'ownerId', 'collection', 'recordId', 'fileName', 'mediaType', 'size', 'sha256', 'chunkCount', 'state', 'publicConsent', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uploadId', 'ownerId', 'collection', 'recordId', 'fileName', 'mediaType', 'size', 'sha256', 'chunkCount', 'state', 'publicConsent', 'createdAt', 'updatedAt'])
        && data.uploadId is string && data.uploadId.matches('[a-f0-9-]{36}') && data.ownerId == uid
        && contentCollection(data.collection) && text(data.recordId, 128) && data.recordId.matches('[a-zA-Z0-9_-]+')
        && (exists(/databases/$(database)/documents/$(data.collection)/$(data.recordId)) || uploadSession(uid, data.collection, data.recordId))
        && text(data.fileName, 120) && data.fileName.size() > 0
        && data.mediaType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && data.size is int && data.size > 0 && data.size <= (data.mediaType == 'application/pdf' ? 20971520 : 8388608)
        && data.sha256 is string && data.sha256.matches('[a-f0-9]{64}')
        && data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 40
        && (data.chunkCount - 1) * 524288 < data.size && data.size <= data.chunkCount * 524288
        && data.state == 'uploading' && data.publicConsent == true
        && data.createdAt == request.time && data.updatedAt == request.time;
    }
    match /uploadRequests/{uid} {
      allow get: if uploadOwner(uid);
      allow list, delete: if false;
      allow create: if uploadOwner(uid) && newUpload(request.resource.data, uid);
      allow update: if uploadOwner(uid) && (
        (resource.data.state in ['complete', 'failed'] && newUpload(request.resource.data, uid)
          && request.resource.data.uploadId != resource.data.uploadId)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && ((resource.data.state == 'uploading' && request.resource.data.state == 'queued')
            || (resource.data.state in ['uploading', 'queued'] && request.resource.data.state == 'cancelled')))
      );
      match /chunks/{chunkId} {
        allow read, delete: if false;
        allow create, update: if uploadOwner(uid) && validChunk(uid, chunkId);
      }
    }
    function validChunk(uid, chunkId) {
      let parent = get(/databases/$(database)/documents/uploadRequests/$(uid)).data;
      let chunk = request.resource.data;
      return parent.state == 'uploading'
        && chunk.keys().hasOnly(['uploadId', 'index', 'data'])
        && chunk.uploadId == parent.uploadId && chunk.index is int
        && chunk.index >= 0 && chunk.index < parent.chunkCount && chunkId == string(chunk.index)
        && chunk.data is bytes && chunk.data.size() == (chunk.index == parent.chunkCount - 1 ? parent.size - chunk.index * 524288 : 524288);
    }

    // Public roster is separate from the private administrator allowlist.
    function validMember(data) {
      return data.keys().hasAll(['name', 'generation', 'isLeader', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'generation', 'isLeader', 'createdAt', 'updatedAt', 'bio'])
        && (!('bio' in data) || text(data.bio, 20000))
        && text(data.name, 40) && data.name.matches('.*[^\\s].*')
        && data.generation is int && data.generation >= 1 && data.generation <= 999
        && data.isLeader is bool && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }
    match /members/{id} {
      allow read: if true;
      allow create: if isAdmin() && validMember(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validMember(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }


    // Personal language choices live only in the visitor's browser.
    // Homepage drafts are private; only explicit publication writes siteSettings.
    function bilingual(value, maximum) {
      return value is map && value.keys().hasAll(['ko', 'en'])
        && value.keys().hasOnly(['ko', 'en'])
        && text(value.ko, maximum) && text(value.en, maximum)
        && (!value.ko.matches('\\s*') || !value.en.matches('\\s*'));
    }
    function homepageSettings(value) {
      return value is map && value.keys().hasAll(['schemaVersion', 'hero'])
        && value.keys().hasOnly(['schemaVersion', 'hero']) && value.schemaVersion == 1
        && value.hero is map && value.hero.keys().hasAll(['title', 'description', 'font'])
        && value.hero.keys().hasOnly(['title', 'description', 'font'])
        && bilingual(value.hero.title, 160) && bilingual(value.hero.description, 3000)
        && value.hero.font in ['original', 'sans', 'serif'];
    }
    function homepageDocument(data) {
      return data.keys().hasAll(['settings', 'revision', 'updatedAt'])
        && data.keys().hasOnly(['settings', 'revision', 'updatedAt'])
        && homepageSettings(data.settings) && data.revision is int && data.revision >= 1
        && data.updatedAt == request.time;
    }
    function matchesHomepageDraft() {
      let draft = getAfter(/databases/$(database)/documents/siteDrafts/homepage).data;
      return draft.settings == request.resource.data.settings && draft.updatedAt == request.time;
    }
    match /siteDrafts/{id} {
      allow get: if id == 'homepage' && isAdmin();
      allow create: if id == 'homepage' && isAdmin() && homepageDocument(request.resource.data)
        && request.resource.data.revision == 1;
      allow update: if id == 'homepage' && isAdmin() && homepageDocument(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1;
      allow list, delete: if false;
    }
    match /siteSettings/{id} {
      allow get: if id == 'homepage';
      allow create: if id == 'homepage' && isAdmin() && homepageDocument(request.resource.data)
        && request.resource.data.revision == 1 && matchesHomepageDraft();
      allow update: if id == 'homepage' && isAdmin() && homepageDocument(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1 && matchesHomepageDraft();
      allow list, delete: if false;
    }

    // Membership is provisioned with the Console/Admin SDK, never by browser clients.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /{name}/{id} {
      allow read: if contentCollection(name) && (resource.data.status == 'published' || isAdmin());
      allow create: if contentCollection(name) && isAdmin() && validContent(name, id)
        && request.resource.data.status == 'draft' && request.resource.data.createdAt == request.time;
      allow update: if contentCollection(name) && isAdmin() && validContent(name, id)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.slug == resource.data.slug
          || !existsAfter(/databases/$(database)/documents/contentSlugs/$(name + ':' + resource.data.slug)));
      allow delete: if false;
    }
    match /contentSlugs/{key} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['collection', 'slug', 'recordId'])
        && contentCollection(request.resource.data.collection)
        && key == request.resource.data.collection + ':' + request.resource.data.slug
        && (!exists(/databases/$(database)/documents/contentSlugs/$(key)) || resource.data.recordId == request.resource.data.recordId)
        && getAfter(/databases/$(database)/documents/$(request.resource.data.collection)/$(request.resource.data.recordId)).data.slug == request.resource.data.slug;
      allow delete: if isAdmin()
        && getAfter(/databases/$(database)/documents/$(resource.data.collection)/$(resource.data.recordId)).data.slug != resource.data.slug;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
