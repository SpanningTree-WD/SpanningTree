VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_PUBLIC_DATA_SOURCE=local
# Set firebase after configuring Authentication, membership, content, and rules.
# Local development only; production builds never connect to emulators.
VITE_USE_FIREBASE_EMULATORS=false
# Public Cloudflare endpoint, e.g. https://spanningtree-upload-trigger.ACCOUNT.workers.dev/trigger
# Leave empty to keep using the scheduled fallback. Never put a GitHub token here.
VITE_UPLOAD_TRIGGER_URL=
